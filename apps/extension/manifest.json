{
  "manifest_version": 3,
  "name": "skilld",
  "version": "1.0.0",
  "action": {
    "default_popup": "src/popup.html"
  },
  "host_permissions": [
    "https://claude.ai/*"
    // TODO: add "https://chatgpt.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["src/content.ts"]
    }
  ]
}
