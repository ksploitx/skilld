# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# ── Postgres ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/skilld

# Test database (used by pytest; auto-created on first test run)
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/skilld_test

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# How long (seconds) to cache search results in Redis. Safe to flush anytime.
SEARCH_CACHE_TTL_SECONDS=60

# ── GitHub scraper ───────────────────────────────────────────────────────────
# Personal access token or GitHub Actions token.
# Anonymous rate limit: 60 req/h. With token: 5000 req/h.
# Required permissions: public_repo (read-only is fine).
GITHUB_TOKEN=

# ── Feature flags ────────────────────────────────────────────────────────────
# skills.sh adapter is a stub until their ToS has been reviewed.
# Do NOT set to true until the adapter is implemented and ToS confirmed.
SKILLS_SH_ENABLED=false
